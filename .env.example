# ==============================================================================
# JADWAL.IN - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Konfigurasi Server & Aplikasi Web
PUBLIC_SITE_NAME="Jadwal.in"
PUBLIC_SITE_URL="http://localhost:4321"
PORT=4321
HOST="0.0.0.0"

# 2. Pengaturan Astro
ASTRO_TELEMETRY_DISABLED=1

# 3. Integrasi AI Eksternal (Beavy AI - Opsional)
# Jika nanti ingin menghubungkan prompt asisten Beavy ke Google Gemini API secara langsung:
GEMINI_API_KEY=""

# 4. Database & Otentikasi Cloud (Opsional)
# Catatan: Sistem autentikasi dan penyimpanan data tugas saat ini berjalan persisten
# di browser (LocalStorage: jadwalin_users_db & jadwalin_data_<email>).
# Isi variabel di bawah ini jika ingin menghubungkan ke database cloud (misal: Supabase/PostgreSQL):
# PUBLIC_SUPABASE_URL=""
# PUBLIC_SUPABASE_ANON_KEY=""
# DATABASE_URL=""
