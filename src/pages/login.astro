---
// src/pages/login.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';
import '../styles/tokens.css';
import Star from 'phosphor-astro/Star.astro';
import Eye from 'phosphor-astro/Eye.astro';
import EyeSlash from 'phosphor-astro/EyeSlash.astro';
import GoogleLogo from 'phosphor-astro/GoogleLogo.astro';
import AppleLogo from 'phosphor-astro/AppleLogo.astro';
import Check from 'phosphor-astro/Check.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>Masuk — Jadwal.in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        background: linear-gradient(135deg, #FDF4E7 0%, #E8D9F3 40%, #CFC4E8 75%, #EBDDF5 100%);
        color: #23163d;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .auth-container {
        width: 100%;
        max-width: 1050px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(226, 218, 238, 0.8);
        border-radius: 28px;
        box-shadow: 0 20px 48px rgba(24, 18, 38, 0.08), 0 4px 12px rgba(24, 18, 38, 0.04);
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        overflow: hidden;
      }

      /* Left Side: Brand & Visuals */
      .auth-visual-side {
        background: linear-gradient(145deg, #f5edfd 0%, #ecdcf9 50%, #f7effe 100%);
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid rgba(139, 92, 246, 0.12);
        position: relative;
        overflow: hidden;
      }

      .brand-top {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .logo-img {
        height: 52px;
        width: auto;
      }

      .visual-content {
        text-align: center;
        padding: 2rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .mascot-wrap {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 30px rgba(24, 18, 38, 0.06);
        margin-bottom: 1.6rem;
        border: 1px solid rgba(255, 255, 255, 0.9);
      }

      .mascot-img {
        width: 150px;
        height: auto;
        object-fit: contain;
      }

      .visual-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1e1335;
        letter-spacing: -0.3px;
        margin-bottom: 0.6rem;
      }

      .visual-desc {
        font-size: 0.88rem;
        color: #64557f;
        line-height: 1.5;
        max-width: 320px;
      }

      .visual-quote-pill {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(139, 92, 246, 0.2);
        padding: 0.6rem 1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        color: #7c3aed;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }

      .quote-icon {
        color: #8b5cf6;
        display: flex;
        align-items: center;
      }

      /* Right Side: Login Form (Figma Match) */
      .auth-form-side {
        padding: 3rem 3.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .form-header {
        margin-bottom: 2rem;
      }

      .form-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #1e1335;
        letter-spacing: -0.3px;
      }

      .form-subtitle {
        font-size: 0.9rem;
        color: #796c92;
        margin-top: 0.3rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 1.2rem;
      }

      .form-label {
        font-size: 0.86rem;
        font-weight: 700;
        color: #3b2b57;
      }

      .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
      }

      .form-input {
        width: 100%;
        padding: 0.85rem 1.1rem;
        border: 1.5px solid #ded5eb;
        border-radius: 12px;
        font-family: inherit;
        font-size: 0.92rem;
        color: #1e1335;
        background: #fdfcff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .form-input:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
      }

      .btn-toggle-pwd {
        position: absolute;
        right: 0.9rem;
        background: none;
        border: none;
        color: #8c7e9f;
        cursor: pointer;
        padding: 0.3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
      }

      .btn-toggle-pwd:hover {
        color: #6d28d9;
      }

      .form-options-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.6rem;
      }

      .remember-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: #5d4e78;
        cursor: pointer;
      }

      .remember-wrap input {
        accent-color: #8b5cf6;
        width: 16px;
        height: 16px;
      }

      .link-forgot {
        font-size: 0.82rem;
        font-weight: 700;
        color: #7c3aed;
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
      }

      .link-forgot:hover {
        text-decoration: underline;
      }

      .btn-submit-login {
        width: 100%;
        padding: 0.9rem;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        font-size: 0.98rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(24, 18, 38, 0.12);
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 1.6rem;
      }

      .btn-submit-login:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(24, 18, 38, 0.16);
      }

      /* Divider & Social Buttons */
      .divider-line {
        display: flex;
        align-items: center;
        text-align: center;
        margin-bottom: 1.4rem;
        color: #9c8eaf;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.6px;
      }

      .divider-line::before, .divider-line::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #ebdff5;
      }

      .divider-line span {
        padding: 0 0.8rem;
      }

      .social-buttons-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9rem;
        margin-bottom: 1.8rem;
      }

      .btn-social {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.75rem;
        border-radius: 12px;
        border: 1.5px solid #ded4eb;
        background: white;
        font-size: 0.88rem;
        font-weight: 700;
        color: #483963;
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-social:hover {
        border-color: #8b5cf6;
        background: #fbf9ff;
        transform: translateY(-1px);
      }

      .auth-switch-text {
        text-align: center;
        font-size: 0.88rem;
        color: #73648e;
      }

      .auth-switch-text a {
        color: #7c3aed;
        font-weight: 700;
        text-decoration: none;
      }

      .auth-switch-text a:hover {
        text-decoration: underline;
      }

      /* Login Success / Feedback Modal */
      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(18, 10, 30, 0.55);
        backdrop-filter: blur(8px);
        z-index: 999;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .modal-backdrop.active {
        display: flex;
      }

      .success-modal-card {
        background: white;
        border-radius: 24px;
        padding: 2.2rem;
        max-width: 400px;
        width: 100%;
        text-align: center;
        box-shadow: 0 20px 48px rgba(24, 18, 38, 0.12), 0 4px 12px rgba(24, 18, 38, 0.04);
        border: 1px solid #ebdff5;
        animation: popUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes popUp {
        from { transform: scale(0.92); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }

      .success-icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #d1fae5;
        color: #059669;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.2rem;
        border: 1px solid #a7f3d0;
      }

      .success-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #1e1335;
        letter-spacing: -0.2px;
        margin-bottom: 0.4rem;
      }

      .success-desc {
        font-size: 0.88rem;
        color: #695b82;
        margin-bottom: 1.6rem;
      }

      .btn-continue-dashboard {
        width: 100%;
        padding: 0.85rem;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: block;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(24, 18, 38, 0.12);
      }

      /* In-Page Toast */
      .auth-toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%) translateY(30px);
        background: #1e1335;
        color: white;
        padding: 0.85rem 1.6rem;
        border-radius: 999px;
        font-size: 0.88rem;
        font-weight: 600;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1000;
        max-width: 90vw;
        text-align: center;
      }

      .auth-toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      .auth-toast.warning {
        background: #c2410c; /* warm amber/orange */
        box-shadow: 0 10px 25px rgba(194, 65, 12, 0.35);
      }

      .auth-toast.error {
        background: #e11d48; /* rose red */
        box-shadow: 0 10px 25px rgba(225, 29, 72, 0.35);
      }

      .auth-toast.success {
        background: #15803d; /* green */
        box-shadow: 0 10px 25px rgba(21, 128, 61, 0.35);
      }

      @media (max-width: 860px) {
        .auth-container {
          grid-template-columns: 1fr;
        }
        .auth-visual-side {
          display: none;
        }
        .auth-form-side {
          padding: 2.2rem 1.8rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="auth-container">
      <!-- 1. LEFT VISUAL SIDE (Desktop) -->
      <div class="auth-visual-side">
        <div class="brand-top">
          <a href="/">
            <Image src={logoImg} alt="Jadwal.in" class="logo-img" loading="eager" />
          </a>
        </div>

        <div class="visual-content">
          <div class="mascot-wrap">
            <Image src={mascotImg} alt="Beavy" class="mascot-img" loading="eager" />
          </div>
          <h2 class="visual-title">Siap Produktif Hari Ini?</h2>
          <p class="visual-desc">
            Biar Beavy yang memprioritaskan jadwal dan tugasmu, kamu tinggal eksekusi satu per satu!
          </p>
        </div>

        <div class="visual-quote-pill">
          <span class="quote-icon">
            <Star aria-hidden="true" width="14" height="14" />
          </span>
          <span>"Kerja cerdas, tenang tanpa panik deadline."</span>
        </div>
      </div>

      <!-- 2. RIGHT FORM SIDE (Figma Match) -->
      <div class="auth-form-side">
        <div class="form-header">
          <h1 class="form-title">Selamat Datang</h1>
          <p class="form-subtitle">Masukkan akunmu untuk melanjutkan ke Jadwal.in</p>
        </div>

        <form id="login-form">
          <!-- Email Input -->
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <div class="input-wrap">
              <input 
                type="email" 
                id="email" 
                class="form-input" 
                placeholder="nama@student.ub.ac.id" 
                required 
              />
            </div>
          </div>

          <!-- Password Input -->
          <div class="form-group">
            <label class="form-label" for="password">Kata Sandi</label>
            <div class="input-wrap">
              <input 
                type="password" 
                id="password" 
                class="form-input" 
                placeholder="Masukkan kata sandi" 
                required 
              />
              <button type="button" id="toggle-pwd" class="btn-toggle-pwd" aria-label="Toggle password visibility">
                <Eye id="icon-eye" width="16" height="16" />
                <EyeSlash id="icon-eye-off" width="16" height="16" style="display: none;" />
              </button>
            </div>
          </div>

          <!-- Options -->
          <div class="form-options-row">
            <label class="remember-wrap">
              <input type="checkbox" id="remember" />
              <span>Ingat saya</span>
            </label>
            <button type="button" id="btn-forgot" class="link-forgot">Lupa Kata Sandi?</button>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-submit-login">
            Masuk Sekarang
          </button>

          <!-- Divider -->
          <div class="divider-line">
            <span>atau lanjutkan dengan</span>
          </div>

          <!-- Social Buttons -->
          <div class="social-buttons-grid">
            <button type="button" class="btn-social" id="btn-google">
              <GoogleLogo width="18" height="18" />
              <span>Google</span>
            </button>
            <button type="button" class="btn-social" id="btn-apple">
              <AppleLogo width="18" height="18" />
              <span>Apple</span>
            </button>
          </div>

          <!-- Switch to Register -->
          <p class="auth-switch-text">
            Belum punya akun? <a href="/register">Daftar sekarang</a>
          </p>
        </form>
      </div>
    </div>

    <!-- Login Success Modal (Figma Frame 92:247) -->
    <div id="login-success-modal" class="modal-backdrop">
      <div class="success-modal-card">
        <div class="success-icon-circle">
          <Check width="28" height="28" />
        </div>
        <h3 class="success-title">Berhasil Masuk!</h3>
        <p class="success-desc">Autentikasi selesai. Selamat datang kembali, Daffa!</p>
        <a href="/beranda" class="btn-continue-dashboard">Lanjut ke Beranda</a>
      </div>
    </div>

    <!-- Toast Component -->
    <div id="auth-toast" class="auth-toast"></div>

    <script>
      import { findUserByEmail, setCurrentUser } from '../utils/db';

      const form = document.getElementById('login-form');
      const modal = document.getElementById('login-success-modal');
      const togglePwd = document.getElementById('toggle-pwd');
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const pwdInput = document.getElementById('password') as HTMLInputElement;
      const rememberInput = document.getElementById('remember') as HTMLInputElement;
      const iconEye = document.getElementById('icon-eye');
      const iconEyeOff = document.getElementById('icon-eye-off');
      const authToast = document.getElementById('auth-toast');
      const successDesc = document.querySelector('.success-desc');

      let toastTimer: any = null;
      function showToast(msg: string, type: 'default' | 'warning' | 'error' | 'success' = 'default') {
        if (!authToast) return;
        clearTimeout(toastTimer);
        authToast.className = 'auth-toast';
        if (type !== 'default') {
          authToast.classList.add(type);
        }
        authToast.textContent = msg;
        authToast.classList.add('show');
        toastTimer = setTimeout(() => {
          authToast.classList.remove('show');
        }, 3600);
      }

      // 1. Cek parameter URL (misal diarahkan setelah registrasi atau akun tidak ditemukan atau auth guard)
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('registered') === '1') {
        const registeredEmail = urlParams.get('email');
        if (registeredEmail && emailInput) {
          emailInput.value = registeredEmail;
        }
        showToast('Pendaftaran akun berhasil! Silakan masukkan kata sandi Anda untuk masuk.', 'success');
        setTimeout(() => pwdInput?.focus(), 300);
      } else if (urlParams.get('auth_required') === '1') {
        showToast('Akses dibatasi! Silakan login atau daftar akun terlebih dahulu untuk membuka dashboard.', 'warning');
      } else if (urlParams.get('logged_out') === '1') {
        showToast('Anda telah berhasil keluar dari akun.', 'default');
      } else if (urlParams.get('email') && emailInput) {
        emailInput.value = urlParams.get('email') || '';
      }

      // Cek apakah ada email yang sebelumnya disimpan (ingat saya)
      const savedEmail = localStorage.getItem('jadwalin_remembered_email');
      if (savedEmail && !urlParams.get('email')) {
        if (emailInput) emailInput.value = savedEmail;
        if (rememberInput) rememberInput.checked = true;
      }

      // 2. Toggle password visibility
      togglePwd?.addEventListener('click', () => {
        if (pwdInput.type === 'password') {
          pwdInput.type = 'text';
          if (iconEye) iconEye.style.display = 'none';
          if (iconEyeOff) iconEyeOff.style.display = 'block';
        } else {
          pwdInput.type = 'password';
          if (iconEye) iconEye.style.display = 'block';
          if (iconEyeOff) iconEyeOff.style.display = 'none';
        }
      });

      // 3. Form Submit Login dengan Validasi Database Akun
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim().toLowerCase() || '';
        const password = pwdInput?.value || '';
        const remember = rememberInput?.checked || false;

        if (!email || !password) {
          showToast('Harap isi email dan kata sandi!', 'error');
          return;
        }

        // Cek akun di database pengguna
        const user = findUserByEmail(email);

        // KASUS 1: Akun belum terdaftar -> arahkan ke halaman register
        if (!user) {
          showToast('Akun belum terdaftar! Mengalihkan ke halaman registrasi...', 'warning');
          setTimeout(() => {
            window.location.href = `/register?email=${encodeURIComponent(email)}&unregistered=1`;
          }, 1400);
          return;
        }

        // KASUS 2: Akun ada, tapi kata sandi salah
        if (user.password && user.password !== password) {
          showToast('Kata sandi yang Anda masukkan salah. Coba lagi!', 'error');
          pwdInput.focus();
          return;
        }

        // KASUS 3: Berhasil Masuk
        setCurrentUser(user);

        if (remember) {
          localStorage.setItem('jadwalin_remembered_email', email);
        } else {
          localStorage.removeItem('jadwalin_remembered_email');
        }

        if (successDesc) {
          const firstName = user.name ? user.name.split(' ')[0] : 'Kamu';
          successDesc.textContent = `Autentikasi selesai. Selamat datang kembali, ${firstName}!`;
        }

        modal?.classList.add('active');
        setTimeout(() => {
          window.location.href = '/beranda';
        }, 1100);
      });

      document.getElementById('btn-forgot')?.addEventListener('click', () => {
        showToast('Tautan instruksi pemulihan kata sandi telah dikirim ke email kamu.', 'default');
      });

      document.getElementById('btn-google')?.addEventListener('click', () => {
        showToast('Menghubungkan akun Google SSO...', 'default');
        const googleUser = {
          id: 'user_google_sso',
          name: 'Daffa Ahmad (Google)',
          email: 'daffaahmadalsch@student.ub.ac.id',
          role: 'Mahasiswa',
          createdAt: new Date().toISOString()
        };
        setCurrentUser(googleUser);
        setTimeout(() => {
          window.location.href = '/beranda';
        }, 800);
      });

      document.getElementById('btn-apple')?.addEventListener('click', () => {
        showToast('Menghubungkan Apple ID...', 'default');
        const appleUser = {
          id: 'user_apple_sso',
          name: 'Daffa Ahmad (Apple)',
          email: 'daffaahmadalsch@student.ub.ac.id',
          role: 'Mahasiswa',
          createdAt: new Date().toISOString()
        };
        setCurrentUser(appleUser);
        setTimeout(() => {
          window.location.href = '/beranda';
        }, 800);
      });
    </script>
  </body>
</html>
